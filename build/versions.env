# The inputs every build of CONSTRUCT fetches from outside the repository, pinned by content.
# Taskfile.yml reads this file (dotenv) and hands each to the build that uses it.

# The image the root is laid in, the tools image, the kernel's toolchain (Clang 23) and the
# harness's security key are built from.
WOLFI_BASE_IMAGE=cgr.dev/chainguard/wolfi-base:latest@sha256:08df5982c3d27e70a4ce1607e3bb9af09d746f8722cf135a7694afef879fc5a2

# The kernel, from kernel.org. A new series can fail the fragments' assertions; Arch's base config
# (kernel/Dockerfile) is pinned to the same version.
KERNEL_VERSION=7.2.10
KERNEL_SHA256=2feaa70453e91f541be6a5c9078d8168e081af45a3d9718054850538cff2ebf3

# Firmware (firmware/Dockerfile): linux-firmware's release, and Intel's microcode from its own.
LINUX_FIRMWARE_VERSION=20260916
LINUX_FIRMWARE_SHA256=f80dcb757a623deda62200c08e0e1a88c76fb6b54964f31b35fa74da1c90ccc5
INTEL_MICROCODE_VERSION=microcode-20260925
INTEL_MICROCODE_SHA256=0ec19023dad1e6dd0c5909174b8dff2555b91cf01671e36271a1ef36655c0cfc

# task scan's scanner. Its vulnerability database is fetched at every scan, whatever this pins.
GRYPE_IMAGE=anchore/grype:latest@sha256:8c2c9234a345577a6d321a4753aa3ee1276d8975c8452d2344a56b57733ecad3

# A release's SBOM (task release:sbom), which the weekly watch scans with Grype: syft 1.54.0.
SYFT_IMAGE=anchore/syft:latest@sha256:0356562f495d432056237fbea5cbc2d4839c9c75cd500784a66de2e7cc95ca7c

# The harness's QEMU (build/qemu), built on Debian: QEMU's release, and canokey-qemu, the emulated
# security key.
HARNESS_DEBIAN_IMAGE=debian:trixie@sha256:f324c7ff54321e8d9c588493a20244965938ce0aa50bbd1022d38010e9ffc4b1
QEMU_VERSION=10.2.4
QEMU_SHA256=821b545b92f165e57dddccac5077d76d4d436a226595b8813ad59306bbfd0746
CANOKEY_QEMU_COMMIT=41044ec17ddb835b3e5acb385a2e429aa74af627
