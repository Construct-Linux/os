# The inputs every build of CONSTRUCT fetches from outside the repository, pinned by content.
# Taskfile.yml reads this file (dotenv) and hands each to the build that uses it.

# The image the root is laid in, the tools image, the kernel's toolchain (Clang 23) and the
# harness's security key are built from.
WOLFI_BASE_IMAGE=cgr.dev/chainguard/wolfi-base:latest@sha256:88a20e2d017bd20cdc0cb3910de603e7bea9512a6c351a8dd3c9df212ab03d73

# The kernel, from kernel.org. A new series can fail the fragments' assertions; Arch's base config
# (kernel/Dockerfile) is pinned to the same version, or Arch's newest while it has none for this one.
KERNEL_VERSION=7.3.1
KERNEL_SHA256=fa595aad93734f829c963c2a90ef7c3673224fd7fdae7b49406e397cde2de231

# Firmware (firmware/Dockerfile): linux-firmware's release, and Intel's microcode from its own.
LINUX_FIRMWARE_VERSION=20261019
LINUX_FIRMWARE_SHA256=a10d1ab5baf2c74ba92e8c7cf313e691696c26bddfa6df00db795e48d70cd4ca
INTEL_MICROCODE_VERSION=microcode-20260925
INTEL_MICROCODE_SHA256=0ec19023dad1e6dd0c5909174b8dff2555b91cf01671e36271a1ef36655c0cfc

# task scan's scanner. Its vulnerability database is fetched at every scan, whatever this pins.
GRYPE_IMAGE=anchore/grype:latest@sha256:621d56d1d68106b787022c81546f7e0a36202a25d1239f0c20195fab8c16f7ea

# A release's SBOM (task release:sbom), which the weekly watch scans with Grype: syft 1.55.0.
SYFT_IMAGE=anchore/syft:latest@sha256:4cc92b64ca74ffca4c94d4c8fcc01f217731375300be14d0b6eeb2e82eaa110a

# The harness's QEMU (build/qemu), built on Debian: QEMU's release, and canokey-qemu, the emulated
# security key.
HARNESS_DEBIAN_IMAGE=debian:trixie@sha256:2dc419c6d7fe3dad0a2f9fd469c34cc90b0f9ba642d8fde837fe3d7d34a0e7f1
QEMU_VERSION=11.1.3
QEMU_SHA256=5a8289c7940dc77d3873c81a6c29ba3afe1446fc9d36e77fa1658cdbecb84b22
CANOKEY_QEMU_COMMIT=41044ec17ddb835b3e5acb385a2e429aa74af627
