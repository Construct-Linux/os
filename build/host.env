# The tools a release builder runs on its host, at the versions this repository is built and tested
# with (build/host-tools.sh installs them). Kept apart from versions.env, whose digest keys the
# cache: a host tool's bump rebuilds no kernel.

# Go: go.mod's go line is the same version (a test holds them together); the tarball is go.dev's.
GO_VERSION=1.27.3
GO_SHA256=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40

# task (taskfile.dev), from its GitHub release.
TASK_VERSION=3.54.0
TASK_SHA256=680859dbb4d881a9c72d4d9a8f510825450849af8567deacd7302c01124416fb

# gh, which publishes a release, from its GitHub release.
GH_VERSION=2.103.0
GH_SHA256=fdd768eb70f6409f80fcfa9f3a1c0adf0fc98d827ab3ce0bed2ac22762c5d786

# What the harness runs on the host, from the distribution: the UEFI firmware its machines boot
# (OVMF, Secure Boot's build), mtools to forge sticks (the lifecycle), dosfstools for the stick
# test plugs into a running session, and ssh into the guests. The builder runs the same Ubuntu
# release as a person's machine, so these are the same versions.
HOST_PACKAGES="ovmf mtools dosfstools openssh-client"

# Docker Engine and buildx, from Docker's apt repository, signed by this key.
DOCKER_VERSION=29.8.0
DOCKER_BUILDX_VERSION=0.37.0
DOCKER_APT_KEY=9DC858229FC7DD38854AE2D88D81803C0EBFCD88
