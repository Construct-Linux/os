# CONSTRUCT's boot screen (cmd/image plymouth.go writes it): the brand's animation - the intro
# once, the loop while the machine boots - and when the disk asks for its password, the outro, its
# last frame the logo, with a field of our own under it - the words GNOME's, in {{.Lang}}. The
# logo then stays until the desktop takes the screen. With a security key, the prompt is for the
# key's PIN, and then a note to touch it - systemd's words, recognised by their English text.
password_text = "{{.Password}}";
key_pin_text = "{{.KeyPIN}}";
touch_text = "{{.Touch}}";
caps_text = "{{.Caps}}";
retry_text = "{{.Retry}}";
font = "Adwaita Sans 14";

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
Plymouth.SetRefreshRate(30);

center_x = Window.GetX() + Window.GetWidth() / 2;

# The frames are drawn at 1080 px, square: 60% of the screen's shorter side, never above that.
size = Math.Int(Math.Min(Math.Min(Window.GetWidth(), Window.GetHeight()) * 0.6, 1080));
frame_x = center_x - size / 2;
frame_y = Window.GetY() + Window.GetHeight() * 0.4 - size / 2;
# Where the outro's last frame - the logo - ends, from the top of the frame.
logo_bottom = frame_y + size * {{.LogoBottom}};

# Plymouth reads an image from the theme's directory, so the brand's are reached from there.
fun frame_image(n)
{
  if (n < 10)
    name = "000" + n;
  else if (n < 100)
    name = "00" + n;
  else
    name = "0" + n;
  return Image("{{.Frames}}frame-" + name + ".png").Scale(size, size);
}

# Each part's frames by number, in the order they play (the brand's sequence.json), and how many.
# The intro and the outro are shown once each, so they are read as they play; the loop's frames,
# shown again and again, are kept by number.
{{.Intro}}
{{.Loop}}
{{.Outro}}
anim = Sprite(frame_image(intro[0]));
anim.SetPosition(frame_x, frame_y, 1);
part = "intro";
shown = 1;
tick = 0;

# The prompt, hidden until asked for: a title, the field, a dot per character, and two notes.
title.password = Image.Text(password_text, 1, 1, 1, 1, font);
title.key = Image.Text(key_pin_text, 1, 1, 1, 1, font);
title.sprite = Sprite(title.password);
title.y = logo_bottom + 32;

fun set_title(image)
{
  title.sprite.SetImage(image);
  title.sprite.SetPosition(center_x - image.GetWidth() / 2, title.y, 2);
}
set_title(title.password);

entry.image = Image("entry.png");
entry.sprite = Sprite(entry.image);
entry.x = center_x - entry.image.GetWidth() / 2;
entry.y = title.y + title.password.GetHeight() + 12;
entry.sprite.SetPosition(entry.x, entry.y, 2);

bullet.image = Image("bullet.png");
bullet.max = 24;
for (i = 0; i < bullet.max; i++)
{
  bullets[i] = Sprite(bullet.image);
  bullets[i].SetPosition(entry.x + 14 + i * (bullet.image.GetWidth() + 6), entry.y + (entry.image.GetHeight() - bullet.image.GetHeight()) / 2, 3);
}

note_y = entry.y + entry.image.GetHeight() + 14;
caps.image = Image.Text(caps_text, 0.95, 0.75, 0.3, 1, font);
caps.sprite = Sprite(caps.image);
caps.sprite.SetPosition(center_x - caps.image.GetWidth() / 2, note_y, 2);

retry.image = Image.Text(retry_text, 0.95, 0.45, 0.45, 1, font);
retry.sprite = Sprite(retry.image);
retry.sprite.SetPosition(center_x - retry.image.GetWidth() / 2, note_y + caps.image.GetHeight() + 6, 2);

# Touching the key comes after its PIN: the note takes the field's place.
touch.image = Image.Text(touch_text, 0, 0.9, 1, 1, font);
touch.sprite = Sprite(touch.image);
touch.sprite.SetPosition(center_x - touch.image.GetWidth() / 2, title.y, 2);
touch.sprite.SetOpacity(0);

asking = 0;
typed = 0;
wrong = 0;

fun show_prompt(opacity)
{
  title.sprite.SetOpacity(opacity);
  entry.sprite.SetOpacity(opacity);
  if (!opacity)
  {
    caps.sprite.SetOpacity(0);
    retry.sprite.SetOpacity(0);
    for (i = 0; i < bullet.max; i++)
      bullets[i].SetOpacity(0);
  }
}

fun play(next)
{
  part = next;
  shown = 0;
}

# The brand's 9.6 frames a second, out of 30 refreshes: the frame is the tick's share of them.
fun refresh()
{
  if (asking)
    caps.sprite.SetOpacity(Plymouth.GetCapslockState());
  tick++;
  n = Math.Int(tick * 0.32);
  if (n == shown_at)
    return;
  shown_at = n;
  if (part == "intro")
  {
    if (shown == intro_frames)
      play("loop");
    else
    {
      anim.SetImage(frame_image(intro[shown]));
      shown++;
    }
  }
  if (part == "loop")
  {
    frame = loop[shown % loop_frames];
    if (!kept[frame])
      kept[frame] = frame_image(frame);
    anim.SetImage(kept[frame]);
    shown++;
  }
  if (part == "outro" && shown < outro_frames)
  {
    anim.SetImage(frame_image(outro[shown]));
    shown++;
  }
}

# A prompt that comes back empty after one was answered is the same one asked again: what was
# typed did not open the disk.
fun display_password(prompt, count)
{
  if (asking && count == 0 && typed > 0)
    wrong = 1;
  if (!asking)
    play("outro");
  if (prompt == "{{.KeyPINPrompt}}")
    set_title(title.key);
  else
    set_title(title.password);
  asking = 1;
  typed = count;
  touch.sprite.SetOpacity(0);
  show_prompt(1);
  retry.sprite.SetOpacity(wrong);
  for (i = 0; i < bullet.max; i++)
    bullets[i].SetOpacity(i < count);
}

# Once the disk is open the logo stays: GDM's handover pauses Plymouth on the frame it shows
# (plymouth deactivate, which a script theme cannot animate), and the desktop replaces the logo.
fun display_normal()
{
  asking = 0;
  show_prompt(0);
}

# systemd asks for the touch with a message, and clears it with an empty one.
fun display_message(text)
{
  if (text == "{{.TouchMessage}}")
  {
    show_prompt(0);
    touch.sprite.SetOpacity(1);
  }
  else if (text == "")
    touch.sprite.SetOpacity(0);
}

fun hide_message(text)
{
  if (text == "{{.TouchMessage}}")
    touch.sprite.SetOpacity(0);
}

shown_at = 0;
show_prompt(0);
Plymouth.SetRefreshFunction(refresh);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetDisplayMessageFunction(display_message);
Plymouth.SetHideMessageFunction(hide_message);
