# CONSTRUCT's boot screen (cmd/image plymouth.go writes it), black from the firmware on: the
# brand's animation - the intro once, the loop while the machine boots - with the mark where the
# dark wallpaper draws it, so it does not move when GDM takes the screen. When the disk asks for
# its password the outro plays, the grid going out until the logo is left, with the shell's unlock
# entry under it - the words GNOME's, in {{.Lang}}, the colors the palette's. Once the disk is
# open the outro plays backwards into the loop, so GDM always takes over on the grid. With a
# security key, the prompt is for the key's PIN, and then a note to touch it - systemd's words,
# recognised by their English text.
password_text = "{{.Password}}";
key_pin_text = "{{.KeyPIN}}";
touch_text = "{{.Touch}}";
caps_text = "{{.Caps}}";
retry_text = "{{.Retry}}";
font = "Adwaita Sans 14";

Window.SetBackgroundTopColor({{.Boot}});
Window.SetBackgroundBottomColor({{.Boot}});
Plymouth.SetRefreshRate(30);

# The screen the layout is for: Plymouth starts on the firmware's framebuffer (simpledrm) and
# moves to the GPU's driver when it loads, whose mode can be another size - in the harness's VM
# 2560x1600 under 2880x1800, on a laptop whose firmware screen is not the panel's native mode the
# same. The layout follows the screen (refresh), or the mark is off centre and jumps at GDM.
screen_w = 0;
screen_h = 0;
size = 0;

# Plymouth reads an image from the theme's directory, so the brand's are reached from there. A
# frame is its file's name, which the image tool writes into the parts' arrays.
fun frame_image(name)
{
  return Image("{{.Frames}}" + name).Scale(size, size);
}

# The intro and the outro are shown once each, so they are read as they play; the loop's frames,
# shown again and again, are kept, each for the size it was scaled to - a screen of another size
# scales anew.
fun show_frame(n)
{
  current = n;
  if (part != "loop")
  {
    anim.SetImage(frame_image(n));
    return;
  }
  key = n + "@" + size;
  if (!kept[key])
    kept[key] = frame_image(n);
  anim.SetImage(kept[key]);
}

# Each part's frames by file name, in the order they play (the brand's sequence.json), and how many.
{{.Intro}}
{{.Loop}}
{{.Outro}}
# Every variable the functions share is made here: a script function's first assignment to a name
# nobody made yet makes it local to that call, and back_at made in display_normal was never the
# one refresh read - the outro never went back. The kept frames and the layout's likewise.
back_at = -1;
kept["none"] = 0;
current = intro[0];
center_x = 0;
frame_x = 0;
frame_y = 0;
logo_bottom = 0;
note_y = 0;
anim = Sprite();
part = "intro";
shown = 1;
tick = 0;

# The prompt, hidden until asked for: a title, the field, a dot per character, and two notes.
title.password = Image.Text(password_text, {{.Text}}, 1, font);
title.key = Image.Text(key_pin_text, {{.Text}}, 1, font);
title.sprite = Sprite(title.password);
title.shown = title.password;
title.y = 0;

fun set_title(image)
{
  title.shown = image;
  title.sprite.SetImage(image);
  title.sprite.SetPosition(center_x - image.GetWidth() / 2, title.y, 2);
}

entry.image = Image("entry.png");
entry.sprite = Sprite(entry.image);
entry.x = 0;
entry.y = 0;

# The dots start past the pill's round end, and as many as fit before the other one.
bullet.image = Image("bullet.png");
bullet.step = bullet.image.GetWidth() + 6;
bullet.max = Math.Int((entry.image.GetWidth() - entry.image.GetHeight() + 6) / bullet.step);
for (i = 0; i < bullet.max; i++)
  bullets[i] = Sprite(bullet.image);

caps.image = Image.Text(caps_text, {{.Warning}}, 1, font);
caps.sprite = Sprite(caps.image);
retry.image = Image.Text(retry_text, {{.Error}}, 1, font);
retry.sprite = Sprite(retry.image);
# Touching the key comes after its PIN: the note takes the field's place.
touch.image = Image.Text(touch_text, {{.Accent}}, 1, font);
touch.sprite = Sprite(touch.image);
touch.sprite.SetOpacity(0);

# Everything placed for the screen there is now.
fun layout()
{
  screen_w = Window.GetWidth();
  screen_h = Window.GetHeight();
  center_x = Window.GetX() + screen_w / 2;
  # The frames are drawn at 1080 px, square: 60% of the screen's shorter side, never above that.
  size = Math.Int(Math.Min(Math.Min(screen_w, screen_h) * 0.6, 1080));
  frame_x = center_x - size / 2;
  # The mark's centre at {{.MarkCenter}} of the screen's height, where the wallpaper has it; it is
  # {{.FrameMarkCenter}} of the way down a frame.
  frame_y = Window.GetY() + screen_h * {{.MarkCenter}} - size * {{.FrameMarkCenter}};
  # Where the outro's last frame - the logo - ends, from the top of the frame.
  logo_bottom = frame_y + size * {{.LogoBottom}};
  anim.SetPosition(frame_x, frame_y, 1);
  show_frame(current);

  title.y = logo_bottom + 32;
  set_title(title.shown);
  entry.x = center_x - entry.image.GetWidth() / 2;
  entry.y = title.y + title.password.GetHeight() + 12;
  entry.sprite.SetPosition(entry.x, entry.y, 2);
  for (i = 0; i < bullet.max; i++)
    bullets[i].SetPosition(entry.x + entry.image.GetHeight() / 2 + i * bullet.step, entry.y + (entry.image.GetHeight() - bullet.image.GetHeight()) / 2, 3);
  note_y = entry.y + entry.image.GetHeight() + 14;
  caps.sprite.SetPosition(center_x - caps.image.GetWidth() / 2, note_y, 2);
  retry.sprite.SetPosition(center_x - retry.image.GetWidth() / 2, note_y + caps.image.GetHeight() + 6, 2);
  touch.sprite.SetPosition(center_x - touch.image.GetWidth() / 2, title.y, 2);
}
layout();

asking = 0;
typed = 0;
wrong = 0;

fun show_prompt(opacity)
{
  title.sprite.SetOpacity(opacity);
  entry.sprite.SetOpacity(opacity);
  if (!opacity)
  {
    caps.sprite.SetOpacity(0);
    retry.sprite.SetOpacity(0);
    for (i = 0; i < bullet.max; i++)
      bullets[i].SetOpacity(0);
  }
}

fun play(next)
{
  part = next;
  shown = 0;
}

# The brand's 9.6 frames a second, out of 30 refreshes: the frame is the tick's share of them.
fun refresh()
{
  if (Window.GetWidth() != screen_w || Window.GetHeight() != screen_h)
    layout();
  if (asking)
    caps.sprite.SetOpacity(Plymouth.GetCapslockState());
  tick++;
  n = Math.Int(tick * 0.32);
  if (n == shown_at)
    return;
  shown_at = n;
  if (part == "intro")
  {
    if (shown == intro_frames)
      play("loop");
    else
    {
      show_frame(intro[shown]);
      shown++;
    }
  }
  if (part == "back")
  {
    if (back_at < 0)
      play("loop");
    else
    {
      show_frame(outro[back_at]);
      back_at--;
    }
  }
  if (part == "loop")
  {
    show_frame(loop[shown % loop_frames]);
    shown++;
  }
  if (part == "outro" && shown < outro_frames)
  {
    show_frame(outro[shown]);
    shown++;
  }
}

# A prompt that comes back empty after one was answered is the same one asked again: what was
# typed did not open the disk.
fun display_password(prompt, count)
{
  if (asking && count == 0 && typed > 0)
    wrong = 1;
  # A second disk's prompt while the outro goes back turns it round where it is.
  if (!asking && part == "back")
  {
    part = "outro";
    shown = back_at + 1;
  }
  else if (!asking)
    play("outro");
  if (prompt == "{{.KeyPINPrompt}}")
    set_title(title.key);
  else
    set_title(title.password);
  asking = 1;
  typed = count;
  touch.sprite.SetOpacity(0);
  show_prompt(1);
  retry.sprite.SetOpacity(wrong);
  for (i = 0; i < bullet.max; i++)
    bullets[i].SetOpacity(i < count);
}

# Once the disk is open the outro goes back from the frame it reached into the loop: GDM's
# handover pauses Plymouth on the frame it shows (plymouth deactivate, which a script theme cannot
# animate), and that frame should be the grid the wallpaper draws, not the bare logo.
fun display_normal()
{
  if (asking)
  {
    part = "back";
    back_at = Math.Min(shown, outro_frames) - 1;
  }
  asking = 0;
  show_prompt(0);
}

# systemd asks for the touch with a message, and clears it with an empty one.
fun display_message(text)
{
  if (text == "{{.TouchMessage}}")
  {
    show_prompt(0);
    touch.sprite.SetOpacity(1);
  }
  else if (text == "")
    touch.sprite.SetOpacity(0);
}

fun hide_message(text)
{
  if (text == "{{.TouchMessage}}")
    touch.sprite.SetOpacity(0);
}

shown_at = 0;
show_prompt(0);
Plymouth.SetRefreshFunction(refresh);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetDisplayMessageFunction(display_message);
Plymouth.SetHideMessageFunction(hide_message);
