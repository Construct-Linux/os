--- a/src/core/gcal-recurrence.c
+++ b/src/core/gcal-recurrence.c
@@ -22,6 +22,30 @@
 
 #include <glib.h>
 
+#if ICAL_CHECK_VERSION (4, 0, 0)
+/* libical 4 sizes BY* arrays instead of ending them with ICAL_RECURRENCE_ARRAY_MAX */
+static gshort
+i_cal_recurrence_get_by_day (ICalRecurrence *rrule,
+                             guint           index)
+{
+  if (index >= i_cal_recurrence_get_by_array_size (rrule, I_CAL_BY_DAY))
+    return -1;
+
+  return i_cal_recurrence_get_by (rrule, I_CAL_BY_DAY, index);
+}
+
+static void
+i_cal_recurrence_set_by_day (ICalRecurrence *rrule,
+                             guint           index,
+                             gshort          value)
+{
+  if (index >= i_cal_recurrence_get_by_array_size (rrule, I_CAL_BY_DAY))
+    i_cal_recurrence_resize_by_array (rrule, I_CAL_BY_DAY, index + 1);
+
+  i_cal_recurrence_set_by (rrule, I_CAL_BY_DAY, index, value);
+}
+#endif
+
 G_DEFINE_BOXED_TYPE (GcalRecurrence, gcal_recurrence, gcal_recurrence_ref, gcal_recurrence_unref)
 
