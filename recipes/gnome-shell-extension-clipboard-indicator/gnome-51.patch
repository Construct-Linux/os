GNOME 51 support for Clipboard Indicator v71: upstream PR #641, not yet merged.
https://github.com/Tudmotu/gnome-shell-extension-clipboard-indicator/pull/641
(head 39a0f9077daca21a62adaa975eb6a03bda499f27)

GNOME 51 removed Clutter.get_default_backend() (mutter !4981) and
St.BoxLayout:vertical (gnome-shell !3614); v71 fails to build its menu and
never starts its clipboard listener. The PR switches to the stage's backend
and to :orientation, and declares shell-version 51.

diff --git a/compat.js b/compat.js
new file mode 100644
index 00000000..83522d7d
--- /dev/null
+++ b/compat.js
@@ -0,0 +1,25 @@
+import Clutter from 'gi://Clutter';
+import * as Config from 'resource:///org/gnome/shell/misc/config.js';
+
+const SHELL_VERSION = Number.parseInt(Config.PACKAGE_VERSION.split('.')[0], 10);
+
+/**
+ * Constructor props for a vertical or horizontal St.BoxLayout.
+ *
+ * GNOME 51 removed St.BoxLayout:vertical in favour of :orientation
+ * (gnome-shell !3614). Keep `vertical` on 46–50 so those shells still
+ * construct.
+ *
+ * @param {boolean} [vertical=true]
+ * @returns {object}
+ */
+export function boxLayoutOrientation(vertical = true) {
+    if (SHELL_VERSION >= 51) {
+        return {
+            orientation: vertical
+                ? Clutter.Orientation.VERTICAL
+                : Clutter.Orientation.HORIZONTAL,
+        };
+    }
+    return { vertical };
+}
