# A stick is written with an image smaller than itself: its GPT ends where the image ended, and
# systemd-repart, which takes the room the table declares, finds none for /var. sfdisk moves the
# backup table to the disk's real end first. Only while there is no /var - a stick's first boot -
# so an installed disk's table is never rewritten at boot.
[Unit]
Description=The boot disk's partition table, stretched to its end
DefaultDependencies=no
BindsTo=dev-disk-spindrift\x2dboot.device
# After the root is open: udev re-reads a disk's partition table when a writer closes it, which
# succeeds while none of its partitions is in use - and a re-read under systemd-veritysetup made
# opening the root fail with EBUSY, a first boot in emergency mode, 1 in 2 in the VM. With the
# root held the re-read is refused and the partitions stay.
After=dev-disk-spindrift\x2dboot.device sysroot.mount
Before=systemd-repart.service
ConditionPathExists=!/dev/disk/by-designator/var

[Service]
Type=oneshot
RemainAfterExit=yes
# --no-reread: the partitions do not move, and the root's are in use.
ExecStart=sfdisk --relocate gpt-bak-std --no-reread --no-tell-kernel /dev/disk/spindrift-boot
