# The disk's password prompt in the person's language and keyboard layout, before Plymouth
# starts: systemd-tmpfiles writes the credentials construct install left on the ESP
# (/usr/lib/construct/boot-language.conf). They come from the ESP, so they are encrypted - to the
# TPM where there is one - and imported decrypted here.
[Unit]
Description=The boot screen in the person's language and keyboard layout
DefaultDependencies=no
After=tpm2.target
Before=plymouth-start.service systemd-vconsole-setup.service

[Service]
Type=oneshot
RemainAfterExit=yes
ImportCredential=construct.vconsole
ImportCredential=construct.plymouth
ExecStart=systemd-tmpfiles --create /usr/lib/construct/boot-language.conf
