# Trayscale at login, in the tray only (the AppIndicator extension shows it): Tailscale's state and
# its exit node a click away, without a window. GDM's greeter starts from its own autostart
# directory, not this one.
[Desktop Entry]
Type=Application
Name=Trayscale
Icon=dev.deedles.Trayscale
Exec=trayscale --hide-window
NoDisplay=true
OnlyShowIn=GNOME;
X-GNOME-Autostart-enabled=true
