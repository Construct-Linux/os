#%PAM-1.0
# GDM's password login and the lock screen's unlock. No pam_gnome_keyring in auth or password: the
# login keyring has no password (construct clearKeyring, gdm-autologin) and is open all session, so
# its auth step only checked the typed password against a keyring that has none and logged an
# error at every unlock - and Wolfi's base-auth lets a wrong password reach it too - while its
# password step would have encrypted the keyring with a new password. The session still starts the
# daemon, which opens a keyring with no password by itself.
auth       include     base-auth
account    include     base-account
password   include     base-password
session    include     base-session
-session   optional    pam_gnome_keyring.so auto_start
