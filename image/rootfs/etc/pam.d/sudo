#%PAM-1.0
# sudo's, on Wolfi's PAM stack (Wolfi's sudo ships none, and it fell back to other): the security
# key's touch first, then the password.
auth       include      construct-key
auth       include      base-auth
account    include      base-account
password   include      base-password
# Wolfi's base-session-noninteractive without pam_systemd, as polkit-1: with it every sudo started
# root's user manager, which warned that /run/user/0/bus was not there and ran the user units
# meant for a person's session.
session    required     pam_env.so
session    required     pam_limits.so
session    required     pam_unix.so
