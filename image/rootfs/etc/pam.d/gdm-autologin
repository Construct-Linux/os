#%PAM-1.0
# GDM logs the person in at boot once /var is open - by their password (the TPM's PIN, or the
# passphrase) or by their security key (cmd/construct makeVar). Their login keyring has no password
# of its own (construct clearKeyring): /var's encryption protects it at rest, so it opens the same
# after either, and no app asks for a keyring password.
auth       optional    pam_gnome_keyring.so
auth       required    pam_permit.so
account    include     base-account
password   include     base-password
session    include     base-session
-session   optional    pam_gnome_keyring.so auto_start
