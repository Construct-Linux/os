# Construct's look, the defaults every user starts from; each person changes them in Settings
# or Tweaks, in their own dconf database. Orchis for the shell and GTK 3: the shell's is the
# system theme (orchis-theme-shell's gnome-shell-theme.gresource), so the lock screen and GDM
# draw it too, where User Themes never runs. libadwaita apps take it from ~/.config/gtk-4.0
# (construct-theme.service, Flatpaks too), built for this GNOME by the Orchis fork and checked in
# task test's screenshots, since each release can break it.

[org/gnome/desktop/interface]
gtk-theme='Orchis-Construct-Dark'
icon-theme='Tela-dark'
cursor-theme='Bibata-Modern-Construct'
accent-color='teal'
color-scheme='prefer-dark'

# The brand's wallpaper (construct-brand), light and dark, on its own colour while it loads.
[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/construct/construct-light.png'
picture-uri-dark='file:///usr/share/backgrounds/construct/construct-dark.png'
picture-options='zoom'
primary-color='#0B1116'
color-shading-type='solid'

# Tiling Shell tiles windows: mutter's own edge tiling and its keys would answer the same gestures
# and keys, and the extension's first enable would write these into each person's dconf.
[org/gnome/mutter]
edge-tiling=false

[org/gnome/mutter/keybindings]
toggle-tiled-left=@as []
toggle-tiled-right=@as []

[org/gnome/desktop/wm/keybindings]
maximize=@as []
unmaximize=@as []

# The set a developer keeps on: tray icons, clipboard history, the panel's tweaks, staying
# awake, system monitors, tiling, a taskbar, and disks and USB sticks on the desktop. User Themes, Workspace Indicator, Removable
# Drive Menu and Night Theme Switcher are installed, off: Orchis is the system shell theme, and
# the last turns libadwaita light by day while the shell and GTK 3 stay on Orchis's dark theme.
[org/gnome/shell]
enabled-extensions=['appindicatorsupport@rgcjonas.gmail.com', 'clipboard-indicator@tudmotu.com', 'just-perfection-desktop@just-perfection', 'caffeine@patapon.info', 'Vitals@CoreCoding.com', 'tilingshell@ferrarodomenico.com', 'dash-to-panel@jderose9.github.com', 'gtk4-ding@smedius.gitlab.com']

# The dock: Files, the browser, the editor, the terminal, Software, Calendar.
favorite-apps=['org.gnome.Nautilus.desktop', 'firefox.desktop', 'code.desktop', 'com.mitchellh.ghostty.desktop', 'org.gnome.Software.desktop', 'org.gnome.Calendar.desktop']

# The app grid's first page, every app the image has outside the dock, in its place. GNOME's own
# layout names Geary first, which the image lacks, and 1Password, which that layout lacks, took
# Geary's place before or after Contacts by the order the icons were laid out in: the grid
# differed boot to boot. A person's own arrangement is saved over it.
app-picker-layout=[{'org.gnome.Contacts.desktop': <{'position': <0>}>, 'com.onepassword.OnePassword.desktop': <{'position': <1>}>, 'org.gnome.Weather.desktop': <{'position': <2>}>, 'org.gnome.clocks.desktop': <{'position': <3>}>, 'org.gnome.Maps.desktop': <{'position': <4>}>, 'org.gnome.Music.desktop': <{'position': <5>}>, 'org.gnome.Calculator.desktop': <{'position': <6>}>, 'org.gnome.Settings.desktop': <{'position': <7>}>, 'io.github.construct_linux.Construct.desktop': <{'position': <8>}>, 'org.gnome.Snapshot.desktop': <{'position': <9>}>, 'org.gnome.Characters.desktop': <{'position': <10>}>, 'Utilities': <{'position': <11>}>, 'System': <{'position': <12>}>, 'com.google.Chrome.desktop': <{'position': <13>}>, 'io.github.construct_linux.Installer.desktop': <{'position': <14>}>, 'org.gnome.Ptyxis.desktop': <{'position': <15>}>, 'org.gnome.TextEditor.desktop': <{'position': <16>}>, 'vim.desktop': <{'position': <17>}>}]

# Ptyxis: the machine, and a tab in the Wolfi container (etc/distrobox/distrobox.conf), whose
# first use creates it.
[org/gnome/Ptyxis]
profile-uuids=['5f0d1a6e2b3c4d8e9f0a1b2c3d4e5f60', '7a1b2c3d4e5f60718293a4b5c6d7e8f9']
default-profile-uuid='5f0d1a6e2b3c4d8e9f0a1b2c3d4e5f60'

[org/gnome/Ptyxis/Profiles/5f0d1a6e2b3c4d8e9f0a1b2c3d4e5f60]
label='Construct'

[org/gnome/Ptyxis/Profiles/7a1b2c3d4e5f60718293a4b5c6d7e8f9]
label='Wolfi'
use-custom-command=true
custom-command='distrobox enter wolfi'

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'

# The layout: GNOME's top bar stays, with the clock and every indicator on the right, and Dash to
# Panel becomes a small dock, centred at the bottom and sized to its icons. Its per-monitor keys
# are JSON by monitor id, falling back to the index: "0" to "2" cover three monitors whatever
# their serials, until the user changes one in its preferences.
# The dock takes the shell theme's top-bar color, opaque g with a ring: dash-to-panel paints
# itself with the theme's #panel, so it sets no background, opacity or border of its own, and
# Orchis owns its 15 px radius. Both bars sit 6 px from the screen's edge. Its focus highlight is
# the accent as the brand's rest tint, like a selected item: 18% over g is #13434F, the accent on
# it 7.02:1. No margin and 2 px of padding: measured at 200%, icons drawn 33 px with 18.5 px
# between them (at 2 and 4: 30 px icons, 26 px apart, near as wide as the icons). What is left
# is the icons' own transparent margin, Tela drawing an app at about 75% of its canvas.
# The session starts in the overview: neither hide-overview-on-startup here nor Just
# Perfection's startup-status is set, because a desktop-first start fades the desktop in over
# GNOME's startup stage instead of rising from the boot's black.
[org/gnome/shell/extensions/dash-to-panel]
# Super+Q is keyd's (Ctrl+Q, quit), not the taskbar's number overlay.
shortcut=@as []
stockgs-keep-top-panel=true
panel-positions='{"0":"BOTTOM","1":"BOTTOM","2":"BOTTOM"}'
panel-lengths='{"0":-1,"1":-1,"2":-1}'
panel-anchors='{"0":"MIDDLE","1":"MIDDLE","2":"MIDDLE"}'
panel-sizes='{"0":44,"1":44,"2":44}'
panel-element-positions='{"0":[{"element":"showAppsButton","visible":true,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":false,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"stackedTL"},{"element":"centerBox","visible":false,"position":"stackedBR"},{"element":"rightBox","visible":false,"position":"stackedBR"},{"element":"dateMenu","visible":false,"position":"stackedBR"},{"element":"systemMenu","visible":false,"position":"stackedBR"},{"element":"desktopButton","visible":false,"position":"stackedBR"}],"1":[{"element":"showAppsButton","visible":true,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":false,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"stackedTL"},{"element":"centerBox","visible":false,"position":"stackedBR"},{"element":"rightBox","visible":false,"position":"stackedBR"},{"element":"dateMenu","visible":false,"position":"stackedBR"},{"element":"systemMenu","visible":false,"position":"stackedBR"},{"element":"desktopButton","visible":false,"position":"stackedBR"}],"2":[{"element":"showAppsButton","visible":true,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":false,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"stackedTL"},{"element":"centerBox","visible":false,"position":"stackedBR"},{"element":"rightBox","visible":false,"position":"stackedBR"},{"element":"dateMenu","visible":false,"position":"stackedBR"},{"element":"systemMenu","visible":false,"position":"stackedBR"},{"element":"desktopButton","visible":false,"position":"stackedBR"}]}'
panel-top-bottom-margins=6
appicon-margin=0
appicon-padding=2
global-border-radius=0
focus-highlight-color='#00E5FF'
focus-highlight-opacity=18
highlight-appicon-hover-background-color='rgba(230,237,242,0.08)'
highlight-appicon-pressed-background-color='rgba(230,237,242,0.14)'
# An icon's tint is a tile inside the dock's ring and 15 px corners, and a running app a dot under
# it: a square tint and a full-width line ran past the dock's rounded end at the last icon, over
# its ring. The 1 px padding keeps the ring outside every tile.
panel-top-bottom-padding=1
panel-side-padding=1
highlight-appicon-hover-border-radius=14
dot-style-focused='DOTS'
dot-style-unfocused='DOTS'
trans-use-border=false
dot-color-override=false

# The focused window's border, when a person turns it on, is the accent.
[org/gnome/shell/extensions/tilingshell]
window-border-color='#00E5FF'

[org/gnome/shell/extensions/just-perfection]
clock-menu-position=1

# Some laptops' screenshot key sends XF86SelectiveScreenshot rather than Print (the ThinkPad
# X9-15p's): both open GNOME's screenshot UI.
# GNOME's USB protection drives USBGuard, which the image has not got: off, so its daemon does
# not ask after it at every lock.
[org/gnome/desktop/privacy]
usb-protection=false

# No smartcard sign-in: the image has no gdm-smartcard PAM service (a security key is FIDO2,
# etc/pam.d/construct-key), so with a key's CCID interface plugged in the lock screen offered a
# mechanism whose every start failed with "PAM service gdm-smartcard was not found".
[org/gnome/login-screen]
enable-smartcard-authentication=false

[org/gnome/shell/keybindings]
show-screenshot-ui=['Print', 'XF86SelectiveScreenshot']
# keyd takes Super with C, V, X, Z, A, S, F, T, W and Q for the clipboard and the rest
# (etc/keyd/default.conf): the shell never sees them, so it binds none. The notification list
# keeps Super+M; the app grid is Super pressed twice; Quick Settings is the panel's menu.
toggle-message-tray=['<Super>m']
toggle-application-view=@as []
toggle-quick-settings=@as []

# Vitals' readings at their own widths: fixed widths reserved room for the widest value each can
# take, which spread the bar out; the bar's numbers are tabular, so a reading keeps its width as
# it changes.
[org/gnome/shell/extensions/vitals]
fixed-widths=false

# Disks and USB sticks on the desktop, mounted ones only: not home, the trash or network shares.
[org/gnome/shell/extensions/gtk4-ding]
show-home=false
show-trash=false
show-volumes=true
show-network-volumes=false
