#!/usr/bin/python3
# Install Construct: the live session's graphical installer. A front-end only - which disk can
# be installed on, checking the release, writing it, the person's records - is construct's
# (cmd/construct): this asks, runs `pkexec construct install --json` and shows what it says.

import gettext
import json
import os
import re
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

# _ is gettext's, for every string a person reads: never a name for unused arguments (*args),
# which would hide it.
_ = gettext.translation("construct-installer", fallback=True).gettext

APP_ID = "io.github.construct_linux.Installer"
CLI = "/usr/bin/construct"
# construct install's: one DNS label (cmd/construct hostname.go).
DEFAULT_HOSTNAME = "construct"
HOSTNAME = re.compile(r"[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?")

# What construct install says as it goes, as the person reads it, and how far along that is.
STEPS = {
    "writing the partition table": (_("Preparing the disk"), 0.03),
    "writing slot A": (_("Copying Construct"), 0.05),
    "making the ESP": (_("Making the disk start Construct"), 0.91),
    "making /var": (_("Encrypting the space for your files"), 0.92),
    "enrolling the TPM": (_("Tying the disk to this computer"), 0.95),
    "preparing /var": (_("Setting up your account"), 0.97),
    "installed: the firmware boots the disk first": (_("Making the disk start first"), 0.99),
}
# construct install asks for each security key to be touched, twice: the step it is at stays.
TOUCH = {"touch the security key", "touch the security key again"}


def session_language():
    """The live session's language and keyboard layout, which the installed machine keeps - and
    which its disk's password prompt speaks and reads keys with."""
    locale = os.environ.get("LANG", "")
    keyboard = ""
    try:
        sources = Gio.Settings.new("org.gnome.desktop.input-sources").get_value("sources").unpack()
        keyboard = next((ident for kind, ident in sources if kind == "xkb"), "")
    except GLib.Error:
        pass
    args = []
    if locale:
        args += ["--locale", locale]
    if keyboard:
        args += ["--keyboard", keyboard]
    return args


def human_size(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1000 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1000


def suggest_login(name):
    first = name.strip().split(" ")[0].lower() if name.strip() else ""
    return re.sub(r"[^a-z0-9_-]", "", first)


class Installer(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=_("Install Construct"), default_width=640, default_height=620)
        self.disks = self.read_disks()
        self.disk = next((d for d in self.disks if d["default"]), self.disks[0] if self.disks else None)
        self.login_edited = False
        self.nav = Adw.NavigationView()
        self.set_content(self.nav)
        self.nav.add(self.welcome_page())

    # construct's disk list: never the stick this runs from.
    def read_disks(self):
        try:
            proc = Gio.Subprocess.new([CLI, "disks", "--json"], Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE)
            _ok, out, _err = proc.communicate_utf8(None, None)
            return json.loads(out) if proc.get_successful() and out else []
        except (GLib.Error, ValueError):
            return []

    def page(self, title, child, tag):
        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(Adw.HeaderBar())
        toolbar.set_content(child)
        return Adw.NavigationPage(title=title, child=toolbar, tag=tag)

    def button(self, label, style, callback):
        b = Gtk.Button(label=label, halign=Gtk.Align.CENTER)
        b.add_css_class("pill")
        b.add_css_class(style)
        b.connect("clicked", callback)
        return b

    def welcome_page(self):
        # The installer is the brand's place (THEMING.md, level 1): its first page shows the mark,
        # not a generic download glyph - the mono mark, which THEMING allows on any surface (the
        # cyan one only on ink or black).
        status = Adw.StatusPage(
            icon_name="construct-logo-symbolic",
            title=_("Install Construct"),
            description=_("Construct is running from this stick. Install it on this computer to keep it, "
                          "or close this window and keep trying it."),
        )
        if self.disk is None:
            status.set_description(_("This computer has no disk Construct can be installed on."))
        else:
            status.set_child(self.button(_("Install…"), "suggested-action", lambda *args: self.nav.push(self.disk_page())))
        return self.page(_("Welcome"), status, "welcome")

    def disk_page(self):
        group = Adw.PreferencesGroup(
            title=_("Where to install"),
            description=_("Everything on the disk you choose is erased."),
        )
        first = None
        for d in self.disks:
            check = Gtk.CheckButton(active=d is self.disk)
            if first is None:
                first = check
            else:
                check.set_group(first)
            check.connect("toggled", lambda c, d=d: c.get_active() and setattr(self, "disk", d))
            row = Adw.ActionRow(
                title=d["model"] or d["path"],
                subtitle=f'{human_size(d["size"])} · {d["path"]}' + (" · " + _("removable") if d["removable"] or d["usb"] else ""),
                activatable_widget=check,
            )
            row.add_prefix(check)
            group.add(row)
        box = self.scrolled(self.form(group, self.button(_("Next"), "suggested-action", lambda *args: self.nav.push(self.person_page()))))
        return self.page(_("Disk"), box, "disk")

    def person_page(self):
        group = Adw.PreferencesGroup(title=_("Who uses this computer"),
                                     description=_("Your password unlocks your session and lets you change the system."))
        self.name = Adw.EntryRow(title=_("Full name"))
        self.login = Adw.EntryRow(title=_("Login name"))
        self.password = Adw.PasswordEntryRow(title=_("Password"))
        self.again = Adw.PasswordEntryRow(title=_("Password again"))
        # The machine's name, as the network and Settings' About show it: construct's default, kept
        # unless changed.
        self.hostname = Adw.EntryRow(title=_("Computer name"), text=DEFAULT_HOSTNAME)
        self.name.connect("changed", self.on_name)
        self.login.connect("changed", lambda *args: setattr(self, "login_edited", self.login.has_focus()))
        for row in (self.name, self.login, self.password, self.again, self.hostname):
            group.add(row)
            row.connect("changed", self.check_person)
        self.person_next = self.button(_("Next"), "suggested-action", lambda *args: self.nav.push(self.key_page()))
        self.person_next.set_sensitive(False)
        self.person_hint = Gtk.Label(css_classes=["dim-label"], wrap=True)
        return self.page(_("You"), self.scrolled(self.form(group, self.person_hint, self.person_next)), "person")

    def on_name(self, *args):
        if not self.login_edited:
            self.login.set_text(suggest_login(self.name.get_text()))

    def check_person(self, *args):
        hint = ""
        if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,30}", self.login.get_text()):
            hint = _("A login name is lowercase letters, digits, - and _, starting with a letter.")
        elif not self.password.get_text():
            hint = _("Choose a password.")
        elif self.password.get_text() != self.again.get_text():
            hint = _("The passwords do not match.")
        elif not HOSTNAME.fullmatch(self.hostname.get_text().strip().lower()):
            hint = _("A computer name is letters, digits and -, up to 63, not starting or ending with -.")
        self.person_hint.set_text(hint)
        self.person_next.set_sensitive(hint == "" and self.name.get_text().strip() != "")

    # The security keys plugged in, as fido2-token lists them: "/dev/hidraw4: vendor=..., product=...
    # (Yubico YubiKey OTP+FIDO+CCID)".
    def read_keys(self):
        try:
            proc = Gio.Subprocess.new(["fido2-token", "-L"], Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE)
            _ok, out, _err = proc.communicate_utf8(None, None)
        except GLib.Error:
            return []
        keys = []
        for line in (out or "").splitlines():
            dev, sep, rest = line.partition(":")
            if sep and dev.startswith("/dev/"):
                name = re.search(r"\(([^)]*)\)\s*$", rest)
                keys.append({"device": dev, "name": name.group(1) if name else dev})
        return keys

    # A security key opens the disk at start with its PIN and a touch, beside the password, and
    # signs the person in with a touch. Optional: Next with none chosen installs without one.
    def key_page(self):
        self.keys = []
        group = Adw.PreferencesGroup(
            title=_("Security key"),
            description=_("Optional. A security key, such as a YubiKey, opens the disk with its PIN and a touch, and "
                          "signs you in with a touch. Your password keeps working without it. A new key gets the PIN "
                          "you type here."))
        refresh = Gtk.Button(icon_name="view-refresh-symbolic", valign=Gtk.Align.CENTER, css_classes=["flat"],
                             tooltip_text=_("Look again for keys"))
        group.set_header_suffix(refresh)
        box = self.scrolled(self.form(group, self.button(_("Next"), "suggested-action", lambda *args: self.nav.push(self.confirm_page()))))
        rows = []

        def fill(*args):
            for row in rows:
                group.remove(row)
            rows.clear()
            self.keys = []
            found = self.read_keys()
            if not found:
                row = Adw.ActionRow(title=_("No security key plugged in"),
                                    subtitle=_("Plug one in and look again, or go on without one."))
                group.add(row)
                rows.append(row)
            for k in found:
                use = Adw.SwitchRow(title=k["name"], subtitle=k["device"])
                pin = Adw.PasswordEntryRow(title=_("Its PIN, 4 or more characters"), sensitive=False)
                use.connect("notify::active", lambda r, *a, pin=pin: pin.set_sensitive(r.get_active()))
                group.add(use)
                group.add(pin)
                rows.extend([use, pin])
                self.keys.append((k["device"], use, pin))

        refresh.connect("clicked", fill)
        fill()
        return self.page(_("Security key"), box, "key")

    def chosen_keys(self):
        return [(dev, pin.get_text()) for dev, use, pin in getattr(self, "keys", []) if use.get_active()]

    def confirm_page(self):
        status = Adw.StatusPage(
            icon_name="dialog-warning-symbolic",
            title=_("Erase %s?") % (self.disk["model"] or self.disk["path"]),
            description=_("Everything on %(path)s (%(size)s) is erased and Construct is installed in its place, "
                          "for %(name)s.") % {"path": self.disk["path"], "size": human_size(self.disk["size"]),
                                                "name": self.name.get_text().strip()},
        )
        status.set_child(self.button(_("Erase and Install"), "destructive-action", self.install))
        return self.page(_("Confirm"), status, "confirm")

    def install(self, *args):
        self.progress = Gtk.ProgressBar(show_text=False)
        self.step = Gtk.Label(label=_("Starting"), css_classes=["title-4"], wrap=True,
                              justify=Gtk.Justification.CENTER)
        status = Adw.StatusPage(icon_name="construct-logo-symbolic", title=_("Installing Construct"))
        status.set_child(self.form(self.step, self.progress))
        page = self.page(_("Installing"), status, "installing")
        page.set_can_pop(False)
        self.nav.push(page)
        self.errors = []
        self.recovery_key = ""
        keys = self.chosen_keys()
        key_args = [a for dev, _pin in keys for a in ("--security-key", dev)]
        if keys:
            key_args += ["--key-pin-file", "-"]
        try:
            proc = Gio.Subprocess.new(
                ["pkexec", CLI, "install", "--yes", "--json", "--disk", self.disk["path"],
                 "--user", self.login.get_text(), "--real-name", self.name.get_text().strip(), "--password-file", "-",
                 "--hostname", self.hostname.get_text().strip().lower()]
                + session_language() + key_args,
                Gio.SubprocessFlags.STDIN_PIPE | Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE,
            )
        except GLib.Error as e:
            return self.failed(e.message)
        stdin = proc.get_stdin_pipe()
        # One pipe through pkexec: the password's line, then each key's PIN.
        stdin.write_all("".join(line + "\n" for line in [self.password.get_text()] + [pin for _d, pin in keys]).encode(), None)
        stdin.close(None)
        self.read_lines(Gio.DataInputStream.new(proc.get_stdout_pipe()), self.on_record)
        self.read_lines(Gio.DataInputStream.new(proc.get_stderr_pipe()), self.errors.append)
        proc.wait_async(None, self.on_exit)

    def read_lines(self, stream, handle):
        def got(s, result):
            line, _len = s.read_line_finish_utf8(result)
            if line is not None:
                handle(line)
                s.read_line_async(GLib.PRIORITY_DEFAULT, None, got)
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, got)

    def on_record(self, line):
        try:
            rec = json.loads(line)
        except ValueError:
            return
        msg = rec.get("msg", "")
        if msg == "done":
            self.recovery_key = rec.get("recovery_key", "")
        elif msg in TOUCH:
            self.step.set_label(self.touch_label(rec))
        elif msg in STEPS:
            text, at = STEPS[msg]
            self.step.set_label(text)
            self.progress.set_fraction(max(self.progress.get_fraction(), at))
        elif msg == "progress" and rec.get("file", "").endswith(".root.raw.xz"):
            self.progress.set_fraction(0.05 + 0.85 * rec.get("percent", 0) / 100)

    # Which key to touch, by the name the security key page showed it with, and its place in the
    # order there: two of the same model share a name, and only the one asked for blinks.
    def touch_label(self, rec):
        names = {dev: use.get_title() for dev, use, _pin in getattr(self, "keys", [])}
        key = names.get(rec.get("device"), _("your security key"))
        if rec.get("of", 1) > 1:
            key = _("%(name)s, key %(n)d of %(of)d") % {"name": key, "n": rec.get("key", 1), "of": rec["of"]}
        label = _("Touch %s when it blinks") % key
        if rec.get("try", 1) > 1:
            label = _("It was not touched in time.") + " " + label
        return label

    def on_exit(self, proc, result):
        proc.wait_finish(result)
        if proc.get_successful():
            self.done()
        else:
            self.failed("\n".join(self.errors[-6:]) or _("The installer stopped."))

    # The recovery key opens the disk in place of a forgotten password: shown here once, never kept.
    def done(self):
        status = Adw.StatusPage(
            icon_name="object-select-symbolic",
            title=_("Construct is installed"),
            description=_("Remove the stick, then restart: the computer starts Construct from its disk and asks for "
                          "your password to open it."),
        )
        key = Gtk.Label(label=self.recovery_key, selectable=True, wrap=True, css_classes=["monospace", "title-4"])
        copy = Gtk.Button(icon_name="edit-copy-symbolic", tooltip_text=_("Copy"), halign=Gtk.Align.CENTER,
                          css_classes=["flat"])
        copy.connect("clicked", lambda *args: self.get_clipboard().set(self.recovery_key))
        note = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER, css_classes=["dim-label"],
                         label=_("This recovery key opens the disk if you forget your password. Write it down "
                                 "and keep it away from the computer: it is not shown again."))
        status.set_child(self.form(note, key, copy,
                                   self.button(_("Restart"), "suggested-action",
                                               lambda *args: Gio.Subprocess.new(["systemctl", "reboot"], 0))))
        page = self.page(_("Done"), status, "done")
        page.set_can_pop(False)
        self.nav.push(page)

    def failed(self, detail):
        detail = detail.replace("construct: ", "")
        # securitykey.ErrNotTouched, after every try construct gave it.
        if "not touched in time" in detail:
            detail = _("Your security key was not touched in time. Install again, and touch the key when it "
                       "blinks.") + "\n\n" + detail
        status = Adw.StatusPage(icon_name="dialog-error-symbolic", title=_("Construct was not installed"),
                                description=detail)
        status.set_child(self.button(_("Back"), "pill", lambda *args: self.nav.pop_to_tag("person")))
        self.nav.push(self.page(_("Error"), status, "error"))

    def form(self, *children):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24, margin_top=24, margin_bottom=24,
                      margin_start=12, margin_end=12)
        for c in children:
            box.append(c)
        return Adw.Clamp(maximum_size=480, child=box)

    # A page's own scrolling, for a form that is the page. Never inside an Adw.StatusPage, which
    # scrolls itself: a ScrolledWindow in it is given its minimum height, a strip a few lines tall,
    # and what is below its first line - the step being done, the recovery key, Restart - is hidden.
    def scrolled(self, child):
        return Gtk.ScrolledWindow(child=child, vexpand=True)


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        (self.props.active_window or Installer(self)).present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
