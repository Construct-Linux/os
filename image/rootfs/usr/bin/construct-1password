#!/bin/sh
# 1Password's launcher: the first time it is opened, construct downloads it from 1Password and
# checks it against their key (pkexec asks for the password or a touch of the security key); after
# that it starts the app.
set -eu
app=/opt/1Password/1password
if [ ! -x "$app" ]; then
	notify-send --app-name=Construct --icon=system-software-install "Installing 1Password" \
		"Downloading it from 1Password and checking its signature: a minute or two."
	if ! pkexec /usr/bin/construct 1password install; then
		notify-send --app-name=Construct --icon=dialog-error "1Password was not installed" \
			"construct 1password install did not finish: try again, or run it in a terminal to see why."
		exit 1
	fi
fi
exec "$app" "$@"
