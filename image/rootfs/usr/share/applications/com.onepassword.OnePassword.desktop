[Desktop Entry]
Name=1Password
Comment=Password manager and secure wallet
Exec=construct-1password %U
Terminal=false
Type=Application
Icon=/opt/1Password/resources/icons/hicolor/256x256/apps/1password.png
StartupWMClass=com.onepassword.OnePassword
MimeType=x-scheme-handler/onepassword;x-scheme-handler/onepassword8;
Categories=Office;
