// The live session runs construct install from the graphical installer (construct-installer) without
// a password: the live user exists only on a stick nobody is installed from (construct live), and is
// root's already through sudo. Only construct, only from the active local session.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/bin/construct" &&
        subject.user == "live" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
