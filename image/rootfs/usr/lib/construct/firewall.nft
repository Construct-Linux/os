#!/usr/bin/nft -f
# The machine's firewall (nftables.service loads it before any network is up): nothing reaches it
# that it did not ask for, but what a network needs to work and what a person turned on.
# Development servers listening on every address (npm's, python -m http.server) stay this
# machine's; Docker publishes on 127.0.0.1 unless told an address (etc/docker/daemon.json), its
# DNAT passing by this chain. What it drops is counted, and the unsolicited logged to the kernel's
# journal under "construct-fw" - a source probing closed ports in numbers as a scan, which is
# then dropped whole for a while - where `construct firewall log` and `construct report` read it.
# A person opens more with `construct firewall allow`, which writes a rule of this chain in
# /etc/nftables.d/*.nft, kept in /var with the rest of /etc.
destroy table inet construct

table inet construct {
	# Sources that probed this machine's closed ports in numbers (the scan rules below), dropped
	# whole for ten minutes: what they send meanwhile reaches no counter per port and no log.
	# `construct firewall status` lists them, `construct firewall unblock` lets one go early.
	set scanners {
		type ipv4_addr
		flags dynamic, timeout
		timeout 10m
	}
	set scanners6 {
		type ipv6_addr
		flags dynamic, timeout
		timeout 10m
	}
	# The rate of unsolicited connection attempts per source, a meter with an entry per address.
	set probes {
		type ipv4_addr
		flags dynamic, timeout
		timeout 1m
		size 65536
	}
	set probes6 {
		type ipv6_addr
		flags dynamic, timeout
		timeout 1m
		size 65536
	}

	chain input {
		type filter hook input priority filter; policy drop;

		ct state established,related accept
		ct state invalid counter drop comment "invalid"
		iif lo accept

		ip saddr @scanners counter drop comment "scanners"
		ip6 saddr @scanners6 counter drop comment "scanners6"

		# Containers reach the host's own services (host.docker.internal) through their bridges.
		iifname "docker0" accept
		iifname "br-*" accept

		# What IPv4 and IPv6 need from the network to work: errors that make a path's size and
		# reachability known, IPv6's neighbours and routers, and an answer to a ping.
		icmp type { destination-unreachable, time-exceeded, parameter-problem, echo-request } accept
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem,
			echo-request, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert,
			mld-listener-query } accept

		# Addresses from DHCP's servers, whose answers come broadcast or link-local.
		udp sport 67 udp dport 68 accept
		ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept

		# mDNS, for printers and Files' network browsing (avahi): its multicast group only.
		ip daddr 224.0.0.251 udp dport 5353 accept
		ip6 daddr ff02::fb udp dport 5353 accept

		# Tailscale: the peers of the person's tailnet - whom its access rules let through - and the
		# port they reach this machine on directly, without a relay (etc/default/tailscaled).
		iifname "tailscale0" accept
		udp dport 41641 accept

		# SSH answers only while sshd listens, which it does once a person ran systemctl enable
		# --now sshd.
		tcp dport 22 counter accept comment "ssh"

		include "/etc/nftables.d/*.nft"

		# What reaches here was not asked for. A source attempting new connections to this
		# machine faster than a person's mistake - over ten a minute - is scanning: logged once,
		# and dropped whole for ten minutes (the sets above).
		ct state new fib daddr type local meta l4proto { tcp, udp } \
			add @probes { ip saddr limit rate over 10/minute burst 10 packets } \
			add @scanners { ip saddr } log prefix "construct-fw scan: " level info counter drop comment "scans"
		ct state new fib daddr type local meta l4proto { tcp, udp } \
			add @probes6 { ip6 saddr limit rate over 10/minute burst 10 packets } \
			add @scanners6 { ip6 saddr } log prefix "construct-fw scan: " level info counter drop comment "scans6"
		# The rest of the unsolicited: unicast to this machine, not the LAN's broadcasts and
		# multicasts, logged at a rate the journal can hold, counted whole.
		ct state new fib daddr type local limit rate 10/minute burst 20 packets log prefix "construct-fw drop: " level info
		ct state new fib daddr type local counter comment "dropped"
	}
}
