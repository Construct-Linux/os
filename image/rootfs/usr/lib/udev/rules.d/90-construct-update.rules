# A stick that carries a release (its construct-update partition, cmd/image usb-disk) updates the
# machine it is plugged into: construct-update@ writes it into the slot the machine did not boot.
ACTION=="add", SUBSYSTEM=="block", ENV{ID_PART_ENTRY_NAME}=="construct-update", TAG+="systemd", ENV{SYSTEMD_WANTS}+="construct-update@%k.service"
