[Unit]
Description=Tell the person a new Construct waits for a reboot

[Service]
Type=oneshot
# Active after the notice is sent: the path unit fires again whenever its service goes inactive
# and the mark, which stays until the reboot, still exists.
RemainAfterExit=yes
# notify-send, not gdbus: a GVariant dictionary's quotes in ExecStart= are systemd's to unquote, and
# the notice failed on every update for that (lifecycle: reboot-notice.txt). Its hints are words.
ExecStart=/bin/sh -c 'notify-send --app-name=Construct --icon=system-software-update --urgency=normal --hint=boolean:resident:true "Construct $(cat /run/construct/reboot-required) is ready" "Restart to start it. If it does not come up, the version you have now starts again by itself."'
