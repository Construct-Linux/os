# libadwaita apps take styles only from ~/.config/gtk-4.0, and a Flatpak's GTK 3 finds a theme only
# in ~/.themes: construct theme copies the image's Orchis to both at every login (real files, which
# a Flatpak reads through the image's read-only override where a link into /usr would point
# nowhere), and leaves a theme the user put there alone. Ghostty reads no system configuration, so
# it also seeds ~/.config/ghostty/config.ghostty with the Construct themes, once: before the
# session, so ahead of Ghostty's first start, and never over a configuration already there.
[Unit]
Description=The image's GTK themes, where apps and Flatpaks read them, and Ghostty's first configuration
Before=graphical-session-pre.target

[Service]
Type=oneshot
ExecStart=/usr/bin/construct theme

[Install]
WantedBy=default.target
