# libadwaita apps take styles only from ~/.config/gtk-4.0: drift gtk4 copies the image's Orchis
# there at every login (real files, which a Flatpak reads through the image's read-only override
# where a link into /usr would point nowhere), and leaves a theme the user put there alone.
[Unit]
Description=The image's GTK 4 theme for libadwaita apps
Before=graphical-session-pre.target

[Service]
Type=oneshot
ExecStart=/usr/bin/drift gtk4

[Install]
WantedBy=default.target
