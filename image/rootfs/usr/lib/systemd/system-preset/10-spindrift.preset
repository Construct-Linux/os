# What the image runs, enabled the way systemd enables units (cmd/image usb's bake runs
# systemctl preset-all): each unit's [Install] decides where it is wanted and which Alias= names
# it answers to, as a package's maintainer wrote them. The first match wins, so this file, before
# the packages' own presets, decides alone: what is not listed is off.

# Names, time, the network (NetworkManager's Also= enables its dispatcher and wait-online).
enable systemd-resolved.service
enable systemd-timesyncd.service
enable NetworkManager.service
# Printers, shares and devices on the local network, which Files and GNOME's dialogs browse
# through gvfs (its Also= enables the socket, its Alias= the bus name).
enable avahi-daemon.service
# The machine: SSD TRIM weekly; memory pressure handled before the kernel's OOM killer
# (usr/lib/systemd/oomd.conf.d).
enable fstrim.timer
enable systemd-oomd.service
# The desktop.
enable gdm.service
enable bluetooth.service
enable power-profiles-daemon.service
enable scx.service
# Printing: cupsd starts when a print dialog asks (its socket and path); cups-browsed finds the
# network's printers. fwupd starts by D-Bus; its timer refreshes LVFS's metadata.
enable cups.socket
enable cups.path
enable cups-browsed.service
enable fwupd-refresh.timer
# Containers.
enable docker.socket
enable containerd.service
# Spindrift's own.
enable spindrift-boot-check.service
enable spindrift-ssh-hostkeys.service
enable spindrift-live.service
enable spindrift-update.timer
enable spindrift-flathub.timer

disable *
