# The caches packages' install triggers would write, which apko does not run: GSettings' compiled
# schemas, fontconfig's, the icon themes' and the MIME database. E2 writes them at boot into the
# root; on the read-only root of the USB disk cmd/image usb has made them already.
[Unit]
Description=Desktop caches packages leave to their triggers
DefaultDependencies=no
After=local-fs.target
ConditionPathIsReadWrite=/usr
Before=display-manager.service systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/glib-compile-schemas /usr/share/glib-2.0/schemas
ExecStart=-/usr/bin/fc-cache -s
ExecStart=-/usr/bin/update-mime-database /usr/share/mime
ExecStart=-/bin/sh -c 'for d in /usr/share/icons/*/; do [ -f "$d/index.theme" ] && gtk4-update-icon-cache -q -t -f "$d"; done; true'
ExecStart=-/usr/bin/dconf update

[Install]
WantedBy=sysinit.target
