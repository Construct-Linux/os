# Updates the machine from the release on /dev/%i, a stick's spin-update partition: mounted
# read-only, checked by systemd-sysupdate against the key the root carries (import-pubring.pgp),
# and written into the slot the machine did not boot (the "stick" component, usr/lib/sysupdate.stick.d). The next boot starts
# it, three times at most until it comes up (boot-complete.target), and falls back to this one
# otherwise.
[Unit]
Description=Update from the release on %I
BindsTo=dev-%i.device
After=dev-%i.device local-fs.target

[Service]
Type=oneshot
RuntimeDirectory=spin-desktop/update
ExecStart=/usr/bin/mount -o ro,nodev,nosuid,noexec /dev/%i /run/spin-desktop/update
# A stick pulled out half way leaves a version written but not bootable, which is not written
# again until it is vacuumed (spin-desktop-update.service says more).
ExecStart=-/usr/lib/systemd/systemd-sysupdate --component=stick vacuum
ExecStart=/usr/lib/systemd/systemd-sysupdate --component=stick update
ExecStartPost=/usr/bin/spin-desktop pending --mark /run/spin-desktop/reboot-required
ExecStopPost=-/usr/bin/umount /run/spin-desktop/update
