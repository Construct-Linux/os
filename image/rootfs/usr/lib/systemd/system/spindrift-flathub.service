# Flathub as the system remote, and Chrome from it: apps the image does not build come from
# Flathub. Started by spindrift-flathub.timer, off the boot's path; it needs the network, so it
# tries again at every boot until it has both, then stays done.
[Unit]
Description=Flathub and the apps installed from it
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/flatpak/app/com.google.Chrome

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
ExecStart=/usr/bin/flatpak install --system --noninteractive -y flathub com.google.Chrome
