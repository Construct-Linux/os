# Keeps 1Password current where construct installed it: the tarball is downloaded only when its
# ETag changed, checked against 1Password's key, and swapped in whole.
[Unit]
Description=Update 1Password
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/1Password/1password

[Service]
Type=oneshot
ExecStart=/usr/bin/construct 1password update
