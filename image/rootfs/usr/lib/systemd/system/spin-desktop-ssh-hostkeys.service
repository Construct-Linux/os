# The host keys systemd-ssh-generator's sshd needs, made on the first boot and kept: nothing in
# the image carries them, so every machine has its own.
[Unit]
Description=SSH host keys
DefaultDependencies=no
After=local-fs.target
Before=sockets.target sshd-vsock.socket sshd-unix-local.socket
ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -A

[Install]
WantedBy=sysinit.target
