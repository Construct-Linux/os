# The host key systemd-ssh-generator's sshd needs - Ed25519, the only kind it offers - made on the
# first boot in /var and kept: nothing in the image carries one, so every machine has its own. A
# boot whose /var cannot be written - a stick spin-init could not give one - makes it in /run, for
# that boot only.
[Unit]
Description=SSH host keys
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service
Before=sockets.target sshd-vsock.socket sshd-unix-local.socket
ConditionPathExists=!/var/lib/sshd/ssh_host_ed25519_key

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'd=/var/lib/sshd; mkdir -p $d 2>/dev/null && touch $d/.w 2>/dev/null && rm $d/.w || d=/run/sshd-keys; mkdir -p $d; [ -f $d/ssh_host_ed25519_key ] || ssh-keygen -q -N "" -t ed25519 -f $d/ssh_host_ed25519_key'

[Install]
WantedBy=sysinit.target
