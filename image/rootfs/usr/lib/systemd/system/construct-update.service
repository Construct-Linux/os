# Downloads the newest release from where releases are published (the default sysupdate
# component, usr/lib/sysupdate.d) and writes it into the slot the machine did not boot, once
# systemd-pull has checked its signature and every file. It never reboots: the person is told
# (construct-reboot-notice), and the next boot starts it - three times at most until it comes
# up, then back to this one.
[Unit]
Description=Update from where releases are published
Wants=network-online.target
After=network-online.target
# An installed machine's (systemd-sysupdated.service.d says why).
ConditionPathExists=/dev/mapper/var

[Service]
Type=oneshot
# An update that stopped half way - a refused kernel image after its slot was written, a lost
# network - is never booted (it has no kernel image), but systemd-sysupdate will not write that
# version again until it is vacuumed.
ExecStartPre=-/usr/lib/systemd/systemd-sysupdate vacuum
ExecStart=/usr/lib/systemd/systemd-sysupdate update
ExecStartPost=/usr/bin/construct pending --mark /run/construct/reboot-required
