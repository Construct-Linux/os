# The host key systemd-ssh-generator's sshd needs - Ed25519, the only kind it offers - made on the
# first boot in /etc/ssh, which the /etc overlay keeps on /var: nothing in the image carries one,
# so every machine has its own. ssh-keygen -A would make RSA and ECDSA keys too. A key that is not
# one - empty, after a power cut caught it unwritten - is made again, and a new one is synced
# before sshd may read it.
[Unit]
Description=SSH host key
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service
Before=sockets.target sshd-vsock.socket sshd-unix-local.socket

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'k=/etc/ssh/ssh_host_ed25519_key; ssh-keygen -y -f $k >/dev/null 2>&1 && exit 0; rm -f $k $k.pub; ssh-keygen -q -N "" -t ed25519 -f $k && sync $k $k.pub /etc/ssh'

[Install]
WantedBy=sysinit.target
