# How CONSTRUCT boots and what it keeps out, over Arch Linux's configuration for the same kernel
# (kernel/Dockerfile's base): what a desktop's hardware needs is desktop.config's, merged after
# this. Every line of both is asserted after olddefconfig, so a line is a promise: one nobody needs
# is a line to delete, and a default stated here is stated because changing it would change what
# CONSTRUCT is.

# --- Booting --------------------------------------------------------------------------------------

# UEFI into a unified kernel image whose initrd has no modules: what finds and opens the root and
# /var, and asks for the password, is built in.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_BLK_DEV_INITRD=y
# The SMBIOS tables as files: systemd reads the credentials firmware passes in type 11 entries from
# them (the harness hands the machine its SSH key and the password this way).
CONFIG_DMI_SYSFS=y
# The TPM, which systemd-stub measures the image into and which seals /var's key: a discrete chip
# (TIS), and Intel PTT and AMD fTPM (CRB) - most laptops'.
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_ACPI_BUTTON=y
CONFIG_INPUT_EVDEV=y
# The disks a machine boots from: NVMe, SATA behind AHCI, a USB stick (usb-storage, UAS).
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
# The password's keyboard, at the initrd's prompt: USB's and a laptop's built-in one (i8042).
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
# The boot screen on the framebuffer the firmware set up, whatever the GPU, until its driver loads.
CONFIG_DRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# The serial console, which the harness reads a boot from.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# Either vendor's processors and their microcode loader: the blobs ride in the kernel image's early
# cpio, before there is a root to load them from.
CONFIG_CPU_SUP_AMD=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_MICROCODE=y
# The IOMMUs and interrupt remapping: a device writes only where its DMA was mapped - a Thunderbolt
# or USB4 device plugged into a locked laptop included.
CONFIG_AMD_IOMMU=y
CONFIG_INTEL_IOMMU=y
CONFIG_IRQ_REMAP=y

# --- Filesystems ----------------------------------------------------------------------------------

# The root: read-only, compressed EROFS under dm-verity. /var: ext4 under dm-crypt (desktop.config).
# The ESP: FAT.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FS_VERITY=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_SWAP=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_VFAT_FS=y

# --- What systemd needs ---------------------------------------------------------------------------

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_BPF=y
CONFIG_CPUSETS=y
# cgroup v2 only: systemd and Docker run on nothing else. What only v1 has is not built.
# CONFIG_MEMCG_V1 is not set
# CONFIG_CPUSETS_V1 is not set
# CONFIG_CGROUP_CPUACCT is not set
# CONFIG_CGROUP_FREEZER is not set
# CONFIG_CGROUP_NET_CLASSID is not set
# CONFIG_CGROUP_NET_PRIO is not set
# tc's cgroup classifier, which would select net_cls back on.
# CONFIG_NET_CLS_CGROUP is not set
CONFIG_PSI=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_KEYS=y
# BTF, which BPF LSM programs attach by - systemd's RestrictFileSystems= among them - through a
# trampoline only a kernel built with the function tracer has.
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
# The running kernel's configuration, in /proc/config.gz.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Memory and scheduling -----------------------------------------------------------------------

# MGLRU: better choices of what to evict when memory runs short.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# Far beyond any desktop; MAXSMP would size every per-CPU table for 8192.
CONFIG_NR_CPUS=512
# CONFIG_MAXSMP is not set
CONFIG_HZ_1000=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_SCHED_CORE=y
# fq on every interface from boot, which paces TCP and keeps a download from filling the Wi-Fi's
# queue ahead of a call.
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y

# --- Hardening -----------------------------------------------------------------------------------

CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
# Integrity lockdown, always: with Secure Boot, nothing on a running machine changes the kernel -
# no unsigned module, no /dev/mem, no kexec, no hibernation image.
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
CONFIG_LSM="landlock,lockdown,yama,bpf"
CONFIG_BPF_LSM=y
# SELinux, which nothing here loads a policy for: the LSMs are the ones CONFIG_LSM names.
# CONFIG_SECURITY_SELINUX is not set
# Forward-edge control-flow integrity (Clang's kCFI, checked through IBT's landing pads): an
# overwritten function pointer stops at a check instead of running an attacker's choice of code.
CONFIG_CC_IS_CLANG=y
CONFIG_CFI=y
# CONFIG_CFI_PERMISSIVE is not set
CONFIG_FINEIBT=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_X86_USER_SHADOW_STACK=y
# CONFIG_DEVPORT is not set
# CONFIG_X86_X32_ABI is not set
# Another kernel loaded past Secure Boot: kexec, and the handover (Live Update) that selects it.
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_KEXEC_HANDOVER is not set
# CONFIG_LIVEUPDATE is not set
# Integrity lockdown refuses to resume a hibernation image, which nothing could sign.
# CONFIG_HIBERNATION is not set
# A host of TDX's confidential VMs: a server's role, and on every machine that is not one it logs
# "TDX not supported by the host platform" as an error at boot.
# CONFIG_INTEL_TDX_HOST is not set

# --- Never built: what any process could reach by asking -----------------------------------------
#
# A socket of an unusual family, a line discipline, a filesystem or an xtables extension: each is
# a kernel's worth of code a desktop never exercises, which any process can still load by asking
# for it - a socket() of its family, or CAP_NET_ADMIN in a network namespace of its own, which a
# user namespace hands out. Fedora and Debian keep the protocols from loading for the same reason;
# here they are not built. AF_ALG's AEAD is how sandboxes were escaped (CVE-2026-31431); its hash
# and cipher sockets, which BlueZ pairs with, are desktop.config's.
# CONFIG_CRYPTO_USER_API_AEAD is not set
# CONFIG_CRYPTO_USER_API_RNG is not set
# CONFIG_IP_SCTP is not set
# CONFIG_RDS is not set
# CONFIG_TIPC is not set
# CONFIG_ATM is not set
# CONFIG_PHONET is not set
# CONFIG_AF_KCM is not set
# CONFIG_AF_RXRPC is not set
# AFS's client, which selects RxRPC back on: the Andrew File System is a few universities'.
# CONFIG_AFS_FS is not set
# CONFIG_SMC is not set
# CONFIG_LLC2 is not set
# CONFIG_N_HDLC is not set
# CONFIG_CRAMFS is not set
# CONFIG_JFFS2_FS is not set
# Docker's rules are iptables-nft's, the extensions below none of them names; and the legacy
# tables nothing uses.
# CONFIG_NETFILTER_XTABLES_LEGACY is not set
# CONFIG_IP_NF_IPTABLES is not set
# CONFIG_IP6_NF_IPTABLES is not set
# CONFIG_NETFILTER_XT_TARGET_CONNSECMARK is not set
# CONFIG_NETFILTER_XT_TARGET_SECMARK is not set
# CONFIG_NETFILTER_XT_TARGET_NFLOG is not set
# CONFIG_NETFILTER_XT_TARGET_LOG is not set
# CONFIG_NETFILTER_XT_TARGET_TCPMSS is not set
# CONFIG_NETFILTER_XT_MATCH_POLICY is not set
# CONFIG_NETFILTER_XT_MATCH_STATE is not set
