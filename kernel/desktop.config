# The desktop kernel, as what it adds to and takes from spin-ami's host.config and metal.config:
# a machine a person sits at - a laptop or a small desktop, Intel or AMD, with its own GPU,
# Wi-Fi, Bluetooth, sound, webcam and docks. It boots as metal does (UEFI, a signed unified
# kernel image, a dm-verity root), and every line here is asserted after olddefconfig as theirs
# are (kernel/Dockerfile).
#
# Unlike metal, drivers are modules: which hardware a desktop has is not known when the image is
# built, and building every driver in would load every one of them on every machine. What keeps
# that controlled is the signature: each module is signed at build time by a key that exists only
# inside that build, and with host.config's integrity lockdown nothing else loads - not a module
# built elsewhere, not one built from this tree by another build.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y

# --- A machine a person uses -------------------------------------------------------------------

# An oops in a Wi-Fi or GPU driver is a bug to report, not a reason to throw away the session a
# person is typing into; a server's reboot-and-recover does not hold here.
# CONFIG_PANIC_ON_OOPS is not set
# Frequency follows load: a laptop on battery and a small box's fan both pay for performance.
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
# Suspend to RAM (S3 and s0ix), the lid, the battery, the fan, the backlight, and the platform
# drivers that make Intel's and AMD's low-power idle reachable. Hibernation stays off: it writes
# memory to a disk the image does not encrypt yet.
CONFIG_SUSPEND=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_VIDEO=m
CONFIG_X86_PLATFORM_DEVICES=y
CONFIG_INTEL_VSEC=m
CONFIG_INTEL_PMT_TELEMETRY=m
CONFIG_INTEL_PMC_CORE=m
CONFIG_AMD_PMC=m
CONFIG_X86_PKG_TEMP_THERMAL=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_RFKILL=y

# Firmware files are stored zstd-compressed (firmware/Dockerfile): iwlwifi alone is 300 MB plain.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# --- Graphics ----------------------------------------------------------------------------------

# Intel (i915 to Tiger Lake/Raptor Lake, xe from Lunar Lake on), AMD, and QEMU's virtio-gpu, which
# is where an image is first seen to reach a session. Their firmware comes from the image's
# /usr/lib/firmware, loaded when the module probes, after the root is mounted.
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_VIRTIO_GPU=m

# --- Input -------------------------------------------------------------------------------------

# Touchpads (I2C HID, multitouch), mice, Logitech's receivers, Apple's keyboards, Bluetooth HID
# from userspace (uhid), and uinput, which remote desktop and on-screen keyboards inject through.
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=m
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=m
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_APPLE=m
CONFIG_UHID=m

# --- Sound -------------------------------------------------------------------------------------

# HDA (the codecs small machines carry, and HDMI/DisplayPort audio), Intel's SOF DSP (Tiger Lake
# to Lunar Lake), and USB audio.
CONFIG_SOUND=y
CONFIG_SND=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_CONEXANT=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_TIGERLAKE=m
CONFIG_SND_SOC_SOF_METEORLAKE=m
CONFIG_SND_SOC_SOF_LUNARLAKE=m
CONFIG_SND_USB_AUDIO=m

# --- Wireless ----------------------------------------------------------------------------------

# Wi-Fi from the vendors laptops and mini PCs ship: Intel (mvm to Wi-Fi 6E, mld for Wi-Fi 7),
# Qualcomm, MediaTek and Realtek.
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=m
CONFIG_MT7925E=m
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW89=m
CONFIG_RTW89_8852BE=m
# Bluetooth over USB, which is how those cards attach it. bluetoothd does LE pairing's AES and
# CMAC through AF_ALG, which host.config keeps out of a server.
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m

# --- What plugs in -----------------------------------------------------------------------------

# Thunderbolt/USB4 and USB-C docks, the USB ethernet they carry, webcams (UVC) and nothing else
# media has - no TV tuners, radio or SDR, which its defaults would build - and SD card readers.
CONFIG_USB4=m
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_USBNET=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_PLATFORM_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m
CONFIG_MMC=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PCI=m
CONFIG_MISC_RTSX_PCI=m
CONFIG_MMC_REALTEK_PCI=m
# The filesystems a USB stick or an SD card comes formatted with, and FUSE, which Flatpak's
# document portal and GVfs mount through.
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_FUSE_FS=m
