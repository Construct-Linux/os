# The desktop kernel, as what it adds to and takes from spin-ami's host.config and metal.config:
# a machine a person sits at - a laptop or a small desktop, Intel or AMD, with its own GPU,
# Wi-Fi, Bluetooth, sound, webcam and docks. It boots as metal does (UEFI, a signed unified
# kernel image, a dm-verity root), and every line here is asserted after olddefconfig as theirs
# are (kernel/Dockerfile).
#
# Unlike metal, drivers are modules: which hardware a desktop has is not known when the image is
# built, and building every driver in would load every one of them on every machine. What keeps
# that controlled is the signature: each module is signed at build time by a key that exists only
# inside that build, and with host.config's integrity lockdown nothing else loads - not a module
# built elsewhere, not one built from this tree by another build.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y

# --- A machine a person uses -------------------------------------------------------------------

# An oops in a Wi-Fi or GPU driver is a bug to report, not a reason to throw away the session a
# person is typing into; a server's reboot-and-recover does not hold here.
# CONFIG_PANIC_ON_OOPS is not set
# Frequency follows load: a laptop on battery and a small box's fan both pay for performance.
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
# Suspend to RAM (S3 and s0ix), the lid, the battery, the fan, the backlight, and the platform
# drivers that make Intel's and AMD's low-power idle reachable. Hibernation stays off: it writes
# memory to a disk the image does not encrypt yet.
CONFIG_SUSPEND=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_VIDEO=m
CONFIG_X86_PLATFORM_DEVICES=y
CONFIG_INTEL_VSEC=m
CONFIG_INTEL_PMT_TELEMETRY=m
CONFIG_INTEL_PMC_CORE=m
CONFIG_AMD_PMC=m
CONFIG_X86_PKG_TEMP_THERMAL=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_RFKILL=y
# The buses a laptop's touchpad, touchscreen and sensors hang off: Intel's LPSS I2C (DesignWare,
# AMD's too) and the pin controllers whose GPIOs carry their interrupts - an I2C HID touchpad needs
# all of it - AMD's SMBus, SPI, and /dev/i2c-* for i2c-tools and sensors-detect. Lunar Lake and
# later describe their pins in ACPI (PINCTRL_INTEL_PLATFORM); older ones each have a driver.
# The controllers' clocks, GPIOs and regulators are frameworks host.config leaves out.
CONFIG_COMMON_CLK=y
CONFIG_GPIOLIB=y
CONFIG_REGULATOR=y
CONFIG_PINCTRL=y
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_MFD_INTEL_LPSS_ACPI=m
CONFIG_I2C_DESIGNWARE_CORE=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m
CONFIG_I2C_DESIGNWARE_PCI=m
CONFIG_PINCTRL_INTEL_PLATFORM=m
CONFIG_PINCTRL_SUNRISEPOINT=m
CONFIG_PINCTRL_CANNONLAKE=m
CONFIG_PINCTRL_ICELAKE=m
CONFIG_PINCTRL_JASPERLAKE=m
CONFIG_PINCTRL_ELKHARTLAKE=m
CONFIG_PINCTRL_TIGERLAKE=m
CONFIG_PINCTRL_ALDERLAKE=m
CONFIG_PINCTRL_METEORLAKE=m
CONFIG_PINCTRL_METEORPOINT=m
CONFIG_PINCTRL_AMD=y
CONFIG_I2C_PIIX4=m
CONFIG_I2C_CHARDEV=m
CONFIG_SPI=y
# Analog Devices' SPI ethernet, which SPI turns on by default: no desktop has one.
# CONFIG_NET_VENDOR_ADI is not set
# Sensors lm-sensors reads beyond the processor's own: desktop boards' Super I/O chips (Nuvoton,
# ITE: temperatures, fans, voltages), disks (drivetemp), and DDR5 and DDR4 memory (SPD5118, JC42,
# EE1004).
CONFIG_SENSORS_NCT6775=m
CONFIG_SENSORS_IT87=m
CONFIG_SENSORS_DRIVETEMP=m
CONFIG_SENSORS_SPD5118=m
CONFIG_SENSORS_JC42=m
CONFIG_EEPROM_EE1004=m
# ThinkPads' keys, fan, LEDs and battery charge thresholds, Intel's hotkeys and convertible
# switches, and Intel's thermal management.
CONFIG_THINKPAD_ACPI=m
CONFIG_INTEL_HID_EVENT=m
CONFIG_INTEL_VBTN=m
CONFIG_INT340X_THERMAL=m
# Intel's Integrated Sensor Hub: the ambient light sensor (automatic brightness), accelerometer
# (rotation) and presence a laptop reports through it, with the vendor firmware it loads.
CONFIG_IIO=m
CONFIG_INTEL_ISH_HID=m
CONFIG_INTEL_ISH_FIRMWARE_DOWNLOADER=m
CONFIG_HID_SENSOR_HUB=m
CONFIG_HID_SENSOR_ALS=m
CONFIG_HID_SENSOR_ACCEL_3D=m
CONFIG_HID_SENSOR_PROX=m
# Intel's NPU, Meteor Lake and later.
CONFIG_DRM_ACCEL=y
CONFIG_DRM_ACCEL_IVPU=m

# Firmware files are stored zstd-compressed (firmware/Dockerfile): iwlwifi alone is 300 MB plain.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# --- Graphics ----------------------------------------------------------------------------------

# Intel (i915 to Tiger Lake/Raptor Lake, xe from Lunar Lake on), AMD, and QEMU's virtio-gpu, which
# is where an image is first seen to reach a session. Their firmware comes from the image's
# /usr/lib/firmware, loaded when the module probes, after the root is mounted.
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMD_DC=y
# AMD's display mode library builds, under clang with host.config's hardening, a 2096-byte frame
# in dml31/dml314 ModeSupportAndSystemConfigurationFull; at the 2048 default -Werror stops the
# build. 2560 lets those through and still fails anything larger.
CONFIG_FRAME_WARN=2560
CONFIG_DRM_VIRTIO_GPU=m

# --- Input -------------------------------------------------------------------------------------

# Touchpads (I2C HID, multitouch), mice, Logitech's receivers, Apple's keyboards, Bluetooth HID
# from userspace (uhid), and uinput, which remote desktop and on-screen keyboards inject through.
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=m
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=m
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_APPLE=m
CONFIG_UHID=m
# Touchpads without a button, which press and click by force and a haptic motor (the ThinkPad X9's).
CONFIG_HID_HAPTIC=y

# --- Sound -------------------------------------------------------------------------------------

# HDA (the codecs small machines carry, and HDMI/DisplayPort audio), Intel's SOF DSP (Tiger Lake
# to Panther Lake), and USB audio.
CONFIG_SOUND=y
CONFIG_SND=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_CONEXANT=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_TIGERLAKE=m
CONFIG_SND_SOC_SOF_METEORLAKE=m
CONFIG_SND_SOC_SOF_LUNARLAKE=m
CONFIG_SND_SOC_SOF_PANTHERLAKE=m
CONFIG_SND_USB_AUDIO=m
# SoundWire, which the DSP's codecs and amplifiers sit on from Meteor Lake's laptops on, with its
# machine driver, HDMI through the DSP, and Cirrus Logic's parts there: the CS42L43 codec and the
# CS35L56/57 amplifiers (the ThinkPad X9's), whose calibration comes from UEFI variables.
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_INTEL=m
CONFIG_SND_SOC_SOF_INTEL_SOUNDWIRE=m
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
CONFIG_SND_SOC_INTEL_MACH=y
# The card's name says the machine (LENOVO-21VV...), which UCM picks the profile by.
CONFIG_SND_SOC_INTEL_USER_FRIENDLY_LONG_NAMES=y
CONFIG_SND_SOC_INTEL_SOUNDWIRE_SOF_MACH=m
CONFIG_MFD_CS42L43_SDW=m
CONFIG_SND_SOC_CS42L43_SDW=m
CONFIG_PINCTRL_CS42L43=m
CONFIG_SPI_CS42L43=m
CONFIG_SND_SOC_CS35L56_SDW=m
CONFIG_SND_SOC_CS35L56_SPI=m
CONFIG_SND_SOC_CS35L56_I2C=m

# --- Wireless ----------------------------------------------------------------------------------

# Wi-Fi from the vendors laptops and mini PCs ship: Intel (mvm to Wi-Fi 6E, mld for Wi-Fi 7),
# Qualcomm, MediaTek and Realtek.
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=m
CONFIG_MT7925E=m
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW89=m
CONFIG_RTW89_8852BE=m
# Bluetooth over USB, which is how those cards attach it. bluetoothd does LE pairing's AES and
# CMAC through AF_ALG, which host.config keeps out of a server.
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIBTUSB_RTL=y
# Intel's Bluetooth on PCIe, Lunar Lake and later (the ThinkPad X9's).
CONFIG_BT_INTEL_PCIE=m

# --- What plugs in -----------------------------------------------------------------------------

# Thunderbolt/USB4 and USB-C docks, the USB ethernet they carry, webcams (UVC) and nothing else
# media has - no TV tuners, radio or SDR, which its defaults would build - and SD card readers.
CONFIG_USB4=m
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_USBNET=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_PLATFORM_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m
# Laptops' own cameras: MIPI sensors behind Intel's IPU6 (Tiger Lake to Meteor Lake) and IPU7
# (Lunar Lake, Panther Lake; staging, its input system without the processing one - libcamera does
# the image processing), found through ACPI (the IPU bridge, INT3472's power and GPIOs), and the
# sensors those laptops carry - the ThinkPad X9's Sony IMX471 among them (kernel/patches).
CONFIG_MEDIA_PCI_SUPPORT=y
CONFIG_VIDEO_INTEL_IPU6=m
CONFIG_STAGING=y
CONFIG_STAGING_MEDIA=y
CONFIG_VIDEO_INTEL_IPU7=m
CONFIG_IPU_BRIDGE=m
CONFIG_INTEL_SKL_INT3472=m
CONFIG_VIDEO_CAMERA_SENSOR=y
CONFIG_VIDEO_IMX471=m
CONFIG_VIDEO_OV02C10=m
CONFIG_VIDEO_OV02E10=m
CONFIG_VIDEO_OV08X40=m
CONFIG_VIDEO_OV2740=m
CONFIG_VIDEO_OV13B10=m
CONFIG_VIDEO_HI556=m
CONFIG_MMC=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PCI=m
CONFIG_MISC_RTSX_PCI=m
CONFIG_MMC_REALTEK_PCI=m
# The filesystems a USB stick or an SD card comes formatted with, and FUSE, which Flatpak's
# document portal and GVfs mount through.
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_FUSE_FS=m

# --- How it is compiled ------------------------------------------------------------------------

# CachyOS's compiler side, none of its patches: Clang ThinLTO, and the AutoFDO and Propeller
# builds, which add the debug info a perf profile is matched against; a profile recorded on a
# machine running this kernel goes back into the next build (CLANG_AUTOFDO_PROFILE,
# CLANG_PROPELLER_PROFILE_PREFIX). kernel/Dockerfile adds -march=x86-64-v3, which Kconfig has no
# symbol for.
CONFIG_LTO_CLANG_THIN=y
CONFIG_AUTOFDO_CLANG=y
CONFIG_PROPELLER_CLANG=y
# A person waits on input, not on throughput: full preemption, which preempt= can still change
# at boot. host.config's lazy model is a server's.
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_LAZY is not set
CONFIG_PREEMPT_DYNAMIC=y
# sched_ext, instead of an out-of-tree scheduler: scx's BPF schedulers (scx_lavd, scx_bpfland)
# load from userspace and fall back to EEVDF when they stop.
CONFIG_SCHED_CLASS_EXT=y

# --- Running as a VM ---------------------------------------------------------------------------

# The guest side of vsock, where systemd-ssh-generator puts sshd when there is a hypervisor:
# cmd/image test reaches the session through it. Built in, so it is there when the generator runs.
CONFIG_VIRTIO_VSOCKETS=y
# metal.config builds NBD in for spin's volumes; built in, its sixteen idle /dev/nbd* devices sit in
# every disk list (Disks, lsblk). A module creates them only when qemu-nbd or a user loads it.
CONFIG_BLK_DEV_NBD=m
# /var is LUKS2 (drift install), opened by spin-init before systemd and udev: everything it needs is
# built in rather than a module nothing would load yet. dm-crypt with AES-XTS through AES-NI for the
# data, and AF_ALG, the kernel crypto libcryptsetup decrypts the keyslots with (and bluez pairs
# devices with).
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
